{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quest Backlog",
  "mainBinaryName": "quest-backlog-desktop",
  "version": "0.1.0",
  "identifier": "com.questbacklog.QuestBacklog",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Quest Backlog",
        "width": 560,
        "height": 600,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.igdb.com https://quest-backlog.com http://localhost:4000; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "Quest Backlog",
    "homepage": "https://quest-backlog.com",
    "category": "Game",
    "shortDescription": "Quest Backlog companion app",
    "longDescription": "Update a game's status and hours on Quest Backlog and post screenshots from a quick panel over the game.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0"],
        "desktopTemplate": "linux/desktop.hbs"
      }
    }
  }
}
